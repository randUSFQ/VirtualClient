# Copia este archivo como .env y completa los valores. NUNCA subas .env a GitHub.

# Configura una o más claves. Solo viven en el servidor; selecciona proveedor/modelos en /admin.
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Contraseña del panel docente (mínimo 6 caracteres)
ADMIN_PASSWORD=cambia-esta-clave

# Código que el docente dice en clase; sin él nadie puede iniciar una entrevista. Déjalo vacío para no pedirlo.
ACCESS_CODE=andina2026

# Restringe el correo a un dominio (sin @). Vacío = cualquier correo.
ALLOWED_EMAIL_DOMAIN=usfq.edu.ec

# Duración de la entrevista en segundos (360 = 6 minutos)
DURACION_SEG=360

# Proveedor/modelos iniciales (pueden cambiarse desde el panel docente sin reiniciar).
LLM_PROVIDER=anthropic
CLIENT_MODEL=claude-3-5-haiku-latest
EVAL_MODEL=claude-3-7-sonnet-latest

# Para probar SIN IA y sin clave (respuestas por palabras clave), descomenta:
# MOCK_LLM=1
